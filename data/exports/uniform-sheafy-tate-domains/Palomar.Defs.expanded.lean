      UniformSpace.Completion.norm_coe, ← Algebra.smul_def, ← coe_nnnorm, ← coe_nnnorm,
      ← coe_nnnorm, nnnorm_eq_gauss, nnnorm_eq_gauss, gauss_smul, NNReal.coe_mul]


