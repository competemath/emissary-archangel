      (algebraMap 𝕜 (𝓤 𝕜 𝓰) (η ⟨H, hH⟩)) • VermaModule.hwVec (weightHW η)
  simpa [weightHW] using VermaModule.apply_hwVec_eq (weightHW η) (Sum.inl ⟨H, hH⟩)


