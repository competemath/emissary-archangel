noncomputable def weightHW (η : weight tri) (i : tri.cartan ⊕ tri.upper) :
    𝓤 𝕜 𝓰 × 𝕜 := match i with
  | Sum.inl H => ⟨ιUEA 𝕜 H, η H⟩
  | Sum.inr E => ⟨ιUEA 𝕜 E, 0⟩


