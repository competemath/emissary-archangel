lemma _root_.VirasoroProject.TriangularDecomposition.VermaHW.cartan_smul_hwVec
    (η : weight tri) {H : 𝓰} (hH : H ∈ tri.cartan) :
    ιUEA 𝕜 H • VermaHW.hwVec η = (η ⟨H, hH⟩) • VermaHW.hwVec η := by
  change
