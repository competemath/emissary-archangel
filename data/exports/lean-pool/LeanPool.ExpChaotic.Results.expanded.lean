/-- The `n`-th iterate of the complex exponential map. -/
abbrev expIterate (n : ℕ) : ℂ → ℂ := ExponentialJuliaSetMisiurewicz.expIterate n


-- @@ L40-42 verbatim
/-- A point escapes if its orbit eventually leaves every centred Euclidean ball. -/
abbrev EscapesToInfinity (z : ℂ) : Prop :=
  ExponentialJuliaSetMisiurewicz.EscapesToInfinity z


-- @@ L44-45 verbatim
/-- The escaping set of the complex exponential map. -/
abbrev escapingSet : Set ℂ := ExponentialJuliaSetMisiurewicz.escapingSetExp


-- @@ L47-48 verbatim
