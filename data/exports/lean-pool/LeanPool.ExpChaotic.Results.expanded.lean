abbrev denseOrbitSet : Set ℂ := ExponentialJuliaSetMisiurewicz.denseOrbitSetExp


-- @@ L50-53 verbatim
/-- The repelling periodic points of the complex exponential map. -/
def repellingPeriodicSet : Set ℂ :=
  {p | ∃ n : ℕ, 0 < n ∧ IsPeriodicPt Complex.exp n p ∧
    1 < ‖deriv (expIterate n) p‖}


-- @@ L55-56 verbatim
/-- The Riemann sphere as the one-point compactification of the complex plane. -/
abbrev RiemannSphere := ExponentialJuliaSetMisiurewicz.RiemannSphere


-- @@ L58-61 verbatim
/-- Compatibility name for the implementation's canonical uniform structure.
The implementation supplies the single registered instance. -/
abbrev riemannSphereUniformSpace : UniformSpace RiemannSphere :=
  ExponentialJuliaSetMisiurewicz.riemannSphereUniformSpace


-- @@ L63-67 verbatim
/-- A sequence of maps is normal on `U` if every subsequence has a further subsequence
converging locally uniformly on `U` to some function from `U` to the uniform codomain. -/
abbrev IsNormalSequenceOn {α β : Type*} [TopologicalSpace α] [UniformSpace β]
    (F : ℕ → α → β) (U : Set α) : Prop :=
  ExponentialJuliaSetMisiurewicz.IsNormalSequenceOn F U


-- @@ L69-70 verbatim
/-- The Fatou set defined by local normality of the sphere-valued iterates. -/
abbrev fatouSet (f : ℂ → ℂ) : Set ℂ := ExponentialJuliaSetMisiurewicz.fatouSet f


-- @@ L72-73 verbatim
/-- The Julia set, defined as the complement of the Fatou set. -/
abbrev juliaSet (f : ℂ → ℂ) : Set ℂ := ExponentialJuliaSetMisiurewicz.juliaSet f


-- @@ L75-78 verbatim
/-- Continuity, dense periodic points, and Mathlib's topological transitivity
for the monoid action generated by iteration. -/
abbrev IsDevaneyChaotic (f : ℂ → ℂ) : Prop :=
  ExponentialJuliaSetMisiurewicz.IsDevaneyChaotic f


-- @@ L80-82 verbatim
/-- The plane-valued exponential iterates, included into the Riemann sphere. -/
abbrev sphericalExpIterate (n : ℕ) (z : ℂ) : RiemannSphere :=
