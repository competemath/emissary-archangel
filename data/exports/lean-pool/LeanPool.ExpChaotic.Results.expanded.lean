-- @@ L84-90 verbatim
/-- Corollary 5.5. Given a prescribed compact set K that omits zero,
every sufficiently high iterate of a nonempty open set covers K. -/
theorem eventually_covers_compact
    {U K : Set ℂ} (hU : IsOpen U) (hUne : U.Nonempty)
    (hK : IsCompact K) (hK0 : (0 : ℂ) ∉ K) :
    ∃ N : ℕ, ∀ n : ℕ, (n ≥ N → K ⊆ expIterate n '' U) := by
  exact ExponentialJuliaSetMisiurewicz.eventually_covers_compact hU hUne hK hK0


-- @@ L92-95 verbatim
/-- The full iterated preimage of every nonzero point is dense. -/
theorem dense_iteratedPreimages_nonzero {w : ℂ} (hw : w ≠ 0) :
    Dense {z : ℂ | ∃ n : ℕ, expIterate n z = w} := by
  exact ExponentialJuliaSetMisiurewicz.dense_iterated_preimages_nonzero hw


-- @@ L97-101 verbatim
/-- The full iterated preimage of the real axis is dense. -/
theorem dense_iteratedPreimages_realAxis :
    Dense {z : ℂ | ∃ n : ℕ, (expIterate n z).im = 0} := by
  simpa [ExponentialJuliaSetMisiurewicz.OnRealAxis] using
    ExponentialJuliaSetMisiurewicz.dense_iterated_preimages_real_axis


-- @@ L103-105 verbatim
/-- Theorem 1.1, part 1., and Theorem 4.1: Escaping points are dense. -/
theorem dense_escapingSet : Dense escapingSet := by
  exact ExponentialJuliaSetMisiurewicz.dense_escapingSet_exp


-- @@ L107-109 verbatim
/-- Theorem 1.1, part 2.: Points with dense forward orbit are dense. -/
theorem dense_denseOrbitSet : Dense denseOrbitSet := by
  exact ExponentialJuliaSetMisiurewicz.dense_denseOrbitSet_exp


-- @@ L111-113 verbatim
/-- Corollary 5.6. There are uncountably many points with dense forward orbit. -/
theorem not_countable_denseOrbitSet : ¬ denseOrbitSet.Countable := by
  exact ExponentialJuliaSetMisiurewicz.not_countable_denseOrbitSet_exp


-- @@ L115-117 verbatim
/-- Theorem 1.1, part 3., and Theorem 6.1: (Repelling) periodic points are dense. -/
theorem dense_repellingPeriodicSet : Dense repellingPeriodicSet := by
