-- @@ L119-123 verbatim
/-- Theorem 5.1. The action generated by iterating the exponential map is
topologically transitive. -/
theorem topologically_transitive :
    MulAction.IsTopologicallyTransitive (IterateMulAct Complex.exp) ℂ := by
  exact ExponentialJuliaSetMisiurewicz.topologically_transitive_exp


-- @@ L125-127 verbatim
/-- Theorem 1.2. The exponential map is chaotic in Devaney's sense. -/
theorem devaney_chaotic : IsDevaneyChaotic Complex.exp := by
  exact ExponentialJuliaSetMisiurewicz.devaney_chaotic_exp


-- @@ L129-133 verbatim
/-- Corollary 4.4 (reformulated): The sphere-valued iterates are not equicontinuous
at any point of the plane. -/
theorem not_equicontinuousAt_sphericalExpIterate (z : ℂ) :
    ¬ EquicontinuousAt sphericalExpIterate z := by
  exact ExponentialJuliaSetMisiurewicz.not_equicontinuousAt_sphericalExpIterate z


-- @@ L135-140 verbatim
/-- Theorem 4.3: infinitely many iterated images of a nonempty open set meet the
negative real axis. Strict negativity strengthens the nonpositive-axis statement in the paper. -/
theorem infinitely_often_hits_negative_realAxis {U : Set ℂ}
    (hU : IsOpen U) (hUne : U.Nonempty) :
    {n : ℕ | ∃ z ∈ U, (expIterate n z).im = 0 ∧ (expIterate n z).re < 0}.Infinite := by
  exact ExponentialJuliaSetMisiurewicz.infinitely_often_hits_negative_realAxis hU hUne


-- @@ L142-148 verbatim
/-- Corollary 4.4, in the precise form of Definition 2.3. The arbitrary positive constants
give Exercise 8.7 as well; the conclusion even holds at every sufficiently late time. -/
theorem spherical_sensitive_dependence_paper {U : Set ℂ}
    (hU : IsOpen U) (hUne : U.Nonempty) {R δ : ℝ} (hR : 0 < R) (hδ : 0 < δ) :
    ∃ N : ℕ, ∀ n : ℕ, (n ≥ N → ∃ z ∈ U, ∃ w ∈ U,
      ‖expIterate n z‖ ≤ R ∧ δ ≤ ‖expIterate n z - expIterate n w‖) := by
  exact ExponentialJuliaSetMisiurewicz.spherical_sensitive_dependence_paper hU hUne hR hδ


-- @@ L150-156 verbatim
/-- Observation 5.2: along any escaping orbit, the real parts and the norms of the
derivatives of the iterates both tend to positive infinity. -/
theorem expansion_along_escaping_orbits {z : ℂ} (hz : EscapesToInfinity z) :
    Tendsto (fun n => (expIterate n z).re) atTop atTop ∧
      Tendsto (fun n => ‖deriv (expIterate n) z‖) atTop atTop := by
  exact ⟨ExponentialJuliaSetMisiurewicz.EscapesToInfinity.tendsto_re hz,
    ExponentialJuliaSetMisiurewicz.EscapesToInfinity.tendsto_norm_deriv hz⟩


-- @@ L158-166 verbatim
/-- No increasing subsequence of the iterates has a locally uniform spherical limit
on a nonempty open set. The arbitrary sphere-valued limit is defined only on that set. -/
theorem not_tendstoLocallyUniformly_sphericalExpIterate
    {U : Set ℂ} (hU : IsOpen U) (hUne : U.Nonempty)
    {φ : ℕ → ℕ} (hφ : StrictMono φ) (g : U → RiemannSphere) :
    ¬ TendstoLocallyUniformly (fun n (z : U) => sphericalExpIterate (φ n) z) g atTop := by
  apply ExponentialJuliaSetMisiurewicz.not_tendstoLocallyUniformly_expIterate_comp
    (q := fun w : ℂ => (w : RiemannSphere)) OnePoint.continuous_coe _ hU hUne hφ g
  exact fun h => (by norm_num : (1 : ℂ) ≠ 2) (OnePoint.coe_injective h)


-- @@ L168-170 verbatim
/-- Misiurewicz's theorem: the Julia set is the whole complex plane. -/
theorem juliaSet_exp : juliaSet Complex.exp = Set.univ := by
  exact ExponentialJuliaSetMisiurewicz.misiurewicz_juliaSet_exp


-- @@ L172-181 verbatim
/-- No strictly increasing subsequence of the iterates has a locally uniform spherical
limit on a nonempty open set. The limit is allowed to be any sphere-valued function.
This directly rules out normality in the sphere-valued formulation, using Mathlib's
`TendstoLocallyUniformlyOn`. All iterates have domain `ℂ`. -/
theorem not_tendstoLocallyUniformlyOn_sphericalExpIterate
    {U : Set ℂ} (hU : IsOpen U) (hUne : U.Nonempty)
    {φ : ℕ → ℕ} (hφ : StrictMono φ) (g : ℂ → RiemannSphere) :
    ¬ TendstoLocallyUniformlyOn (fun n => sphericalExpIterate (φ n)) g atTop U := by
  exact ExponentialJuliaSetMisiurewicz.not_tendstoLocallyUniformlyOn_sphericalExpIterate
    hU hUne hφ g



