-- @@ L209-215 verbatim
/-- The interval cell, regarded as a path from the source to the target. -/
def graphRealizationForwardPath {V : Type u} [Quiver.{u} V]
    {a b : V} (e : a ⟶ b) :
    Path (graphVertex a) (graphVertex b) where
  toContinuousMap := graphEdgePath ⟨a, b, e⟩
  source' := graphEdgePath_zero ⟨a, b, e⟩
  target' := graphEdgePath_one ⟨a, b, e⟩


-- @@ L217-224 verbatim
/-- A continuous parametrisation of the part of an interval cell from `t` to
    its source endpoint. -/
def graphEdgeRetraction (t : I) : C(I, I) where
  toFun s :=
    ⟨(1 - (s : ℝ)) * (t : ℝ),
      unitInterval.mul_mem
        ⟨unitInterval.one_minus_nonneg s, unitInterval.one_minus_le_one s⟩ t.2⟩
  continuous_toFun := by fun_prop


-- @@ L226-229 verbatim
@[simp]
theorem graphEdgeRetraction_zero (t : I) : graphEdgeRetraction t 0 = t := by
  apply Subtype.ext
  simp [graphEdgeRetraction]


-- @@ L231-234 verbatim
@[simp]
theorem graphEdgeRetraction_one (t : I) : graphEdgeRetraction t 1 = 0 := by
  apply Subtype.ext
  simp [graphEdgeRetraction]


-- @@ L236-242 verbatim
/-- The homotopy moving points of an edge interval toward its source. -/
def graphEdgePathToSource {V : Type u} [Quiver.{u} V]
    (e : Quiver.Total V) (t : I) :
    Path (graphEdgePath e t) (graphVertex e.left) where
  toContinuousMap := (graphEdgePath e).comp (graphEdgeRetraction t)
  source' := by simp
  target' := by simp


-- @@ L244-256 verbatim
theorem graphRealizationPre_join_vertex {V : Type u} [Quiver.{u} V]
    (x : graphRealizationPre V) :
    ∃ v : V, Joined (graphRealizationQuotient x) (graphVertex v) := by
  cases x with
  | inl v =>
      refine ⟨graphVertexUnderlying v, ?_⟩
      exact ⟨Path.refl _⟩
  | inr z =>
      rcases z with ⟨e, t⟩
      refine ⟨(graphEdgeUnderlying e).left, ?_⟩
      refine ⟨?path⟩
      simpa [graphEdgePath, graphEdgeUnderlying, graphDiscreteEdge] using
        (graphEdgePathToSource (graphEdgeUnderlying e) t)


-- @@ L258-261 verbatim
/-! The symmetrified quiver is the combinatorial source used by the free
    groupoid.  Its positive arrows use the characteristic interval in the
    forward direction, while its negative arrows use the same interval in
