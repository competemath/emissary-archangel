-- @@ L436-444 verbatim
/-- Changes the basepoint of the topological fundamental group along a chosen graph path. -/
noncomputable def graphTopologicalRootEquiv {V : Type u} [Quiver.{u} V]
    [WeaklyConnected V] (root₁ root₂ : V) :
    FundamentalGroup (graphRealization V) (graphVertex root₁) ≃*
      FundamentalGroup (graphRealization V) (graphVertex root₂) := by
  letI : PathConnectedSpace (graphRealization V) :=
    graphRealization_pathConnected root₁
  exact FundamentalGroup.fundamentalGroupMulEquivOfPathConnected
    (graphVertex root₁) (graphVertex root₂)


