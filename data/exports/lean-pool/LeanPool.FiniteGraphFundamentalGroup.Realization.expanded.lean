theorem graphRealizationQuotient_vertex {V : Type u} [Quiver.{u} V] (v : V) :
    graphRealizationQuotient (Sum.inl (graphDiscreteVertex v)) = graphVertex v := rfl


-- @@ L187-190 verbatim
@[simp]
theorem graphEdgePath_zero {V : Type u} [Quiver.{u} V] (e : Quiver.Total V) :
