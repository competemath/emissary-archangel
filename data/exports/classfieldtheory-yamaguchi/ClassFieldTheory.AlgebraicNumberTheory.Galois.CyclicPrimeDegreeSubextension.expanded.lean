/-- A fixed generator of the cyclic Galois group. -/
noncomputable def cyclicGaloisGenerator : L ≃ₐ[K] L :=
  (IsCyclic.exists_generator (α := L ≃ₐ[K] L)).choose


-- @@ L35-39 expanded
omit [FiniteDimensional K L] [IsGalois K L] in
theorem mem_zpowers_cyclicGaloisGenerator (σ : L ≃ₐ[K] L) :
    σ ∈ Subgroup.zpowers (cyclicGaloisGenerator (K := K) (L := L)) :=
  (IsCyclic.exists_generator (α := L ≃ₐ[K] L)).choose_spec σ


-- @@ L41-46 verbatim
theorem orderOf_cyclicGaloisGenerator :
    orderOf (cyclicGaloisGenerator (K := K) (L := L)) =
      Module.finrank K L := by
  rw [orderOf_eq_card_of_forall_mem_zpowers
    (mem_zpowers_cyclicGaloisGenerator (K := K) (L := L))]
  exact IsGalois.card_aut_eq_finrank K L


