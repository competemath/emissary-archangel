/-- A prime divisor of the degree of a nontrivial cyclic extension. -/
noncomputable def cyclicDegreePrime
    (hdegree : 1 < Module.finrank K L) : ℕ :=
  (Nat.exists_prime_and_dvd
    (ne_of_gt hdegree)).choose


