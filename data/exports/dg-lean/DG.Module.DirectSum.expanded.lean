/-- The morphism into the graded product determined by its components. -/
def pi (f : ∀ i, DGModuleHom A N (M i)) : DGModuleHom A N (GradedPi A M)
    where
  __ :=
    LinearMap.codRestrict (GradedPi.submodule A M) (LinearMap.pi fun i => (f i).toLinearMap)
      (pi_mem f)
  map_mem' hx := (GradedPi.mem_grading A M).mpr fun i => (f i).map_mem hx
  map_d' x := GradedPi.ext A M fun i => (f i).map_d x


