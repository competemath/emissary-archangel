-- @@ L185-201 verbatim
/-- The graded product as a submodule of the product: the submodule generated by the families
of homogeneous elements of a fixed degree. -/
def submodule : Submodule A (∀ i, M i) where
  __ := (⨆ n, piGrading M n).toAddSubmonoid
  smul_mem' a x hx := by
    change x ∈ ⨆ n, piGrading M n at hx
    change a • x ∈ ⨆ n, piGrading M n
    refine AddSubgroup.iSup_induction _ (C := fun x => a • x ∈ ⨆ n, piGrading M n) hx
      (fun n x hx => ?_) (by rw [smul_zero]; exact zero_mem _)
      (fun x y hx hy => by rw [smul_add]; exact add_mem hx hy)
    induction a using DG.induction_on with
    | h_zero => rw [zero_smul]; exact zero_mem _
    | @h_homogeneous k a =>
      refine AddSubgroup.mem_iSup_of_mem (k + n) ((mem_piGrading_iff M).mpr fun i => ?_)
      rw [Pi.smul_apply]
      exact smul_mem_grading a.2 ((mem_piGrading_iff M).mp hx i)
    | h_add a a' ha ha' => rw [add_smul]; exact add_mem ha ha'


-- @@ L203-204 verbatim
theorem mem_submodule_iff {x : ∀ i, M i} : x ∈ submodule A M ↔ x ∈ ⨆ n, piGrading M n :=
  Iff.rfl


