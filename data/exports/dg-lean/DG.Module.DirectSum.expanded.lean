-- @@ L374-378 expanded
/-- Two morphisms into a graded product with the same components are equal. -/
theorem gradedPi_ext {f g : DGModuleHom A N (GradedPi A M)}
    (h : ∀ i, (proj A M i).comp f = (proj A M i).comp g) : f = g :=
  DGModuleHom.ext fun x =>
    GradedPi.ext A M fun i => congrArg (fun φ : DGModuleHom A N (M i) => φ x) (h i)


