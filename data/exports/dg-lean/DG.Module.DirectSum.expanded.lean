variable {A M} {N : Type*} [AddCommGroup N] [DGAddCommGroup N] [Module A N]


-- @@ L345-358 expanded
omit [∀ i, DGModule A (M i)] in
theorem pi_mem (f : ∀ i, DGModuleHom A N (M i)) (x : N) :
    (fun i => f i x) ∈ ⨆ n, GradedPi.piGrading M n := by
  induction x using DG.induction_on with
  | h_zero =>
    have : (fun i => f i (0 : N)) = 0 := funext fun i => map_zero (f i)
    rw [this]; exact zero_mem _
  | h_homogeneous x =>
    exact
      AddSubgroup.mem_iSup_of_mem _ ((GradedPi.mem_piGrading_iff M).mpr fun i => (f i).map_mem x.2)
  | h_add x y hx
    hy =>
    have : (fun i => f i (x + y)) = (fun i => f i x) + fun i => f i y :=
      funext fun i => map_add (f i) x y
    rw [this]; exact add_mem hx hy


