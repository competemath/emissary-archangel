-- @@ L129-151 expanded
/-- The morphism out of a direct sum determined by its restrictions to the summands. -/
def toModule (f : ∀ i, DGModuleHom A (M i) N) : DGModuleHom A (⨁ i, M i) N
    where
  __ := DirectSum.toModule A ι N fun i => (f i).toLinearMap
  map_mem' := by
    classical
    intro n x hx
    change DirectSum.toModule A ι N (fun i => (f i).toLinearMap) x ∈ _
    rw [← DirectSum.sum_support_of x, map_sum]
    refine sum_mem fun i _ => ?_
    rw [← DirectSum.lof_eq_of A, DirectSum.toModule_lof]
    exact (f i).map_mem (hx i)
  map_d'
    x := by
    let T := DirectSum.toModule A ι N fun i => (f i).toLinearMap
    change T (DirectSum.d M x) = DGAddCommGroup.d (T x)
    have h :
      T.toAddMonoidHom.comp (DirectSum.d M) = (DGAddCommGroup.d : N →+ N).comp T.toAddMonoidHom :=
      DirectSum.addHom_ext fun i m =>
        by
        simp only [AddMonoidHom.comp_apply, LinearMap.toAddMonoidHom_coe, DirectSum.d,
          DirectSum.map_of, T]
        rw [← DirectSum.lof_eq_of A, ← DirectSum.lof_eq_of A, DirectSum.toModule_lof,
          DirectSum.toModule_lof]
        exact (f i).map_d m
    exact congrArg (fun φ : (⨁ i, M i) →+ N => φ x) h


