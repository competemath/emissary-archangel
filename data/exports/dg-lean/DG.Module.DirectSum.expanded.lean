  DirectSum.toModule_lof A i m


-- @@ L158-161 expanded
@[simp]
theorem toModule_comp_lof (f : ∀ i, DGModuleHom A (M i) N) (i : ι) :
    (toModule f).comp (lof A M i) = f i :=
  DGModuleHom.ext fun m => toModule_lof f i m


-- @@ L163-167 expanded
/-- Two morphisms out of a direct sum agreeing on the summands are equal. -/
theorem directSum_ext {f g : DGModuleHom A (⨁ i, M i) N}
    (h : ∀ i, f.comp (lof A M i) = g.comp (lof A M i)) : f = g :=
  toLinearMap_injective <|
    DirectSum.linearMap_ext A fun i =>
      LinearMap.ext fun m => congrArg (fun φ : DGModuleHom A (M i) N => φ m) (h i)


