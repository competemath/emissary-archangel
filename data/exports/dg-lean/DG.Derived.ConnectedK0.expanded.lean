/-- The **augmentation** `A → ℤ`, `a ↦ a₀`, of a connected dg ring, a morphism of dg rings. -/
noncomputable def augmentation : DGRingHom A ℤ
    where
  toFun := hA.toInt
  map_one' :=
    hA.intCast_injective
      (by rw [hA.toInt_spec, decompose_of_mem_same _ one_mem_grading, Int.cast_one])
  map_mul' a
    b :=
    hA.intCast_injective
      (by
        rw [hA.toInt_spec, Int.cast_mul, hA.toInt_spec, hA.toInt_spec,
          coe_decompose_mul_zero hA.grading_neg a b])
  map_zero' :=
    hA.intCast_injective
      (by
        rw [hA.toInt_spec, decompose_zero, Int.cast_zero]
        rfl)
  map_add' a
    b :=
    hA.intCast_injective
      (by
        rw [Int.cast_add, hA.toInt_spec, hA.toInt_spec, hA.toInt_spec, decompose_add]
        rfl)
  map_mem' {n} {a}
    ha := by
    rw [mem_grading_iff]
    by_cases hn : n = 0
    · exact Or.inl hn
    · refine Or.inr (hA.intCast_injective ?_)
      rw [hA.toInt_spec, decompose_of_mem_ne _ ha hn, Int.cast_zero]
  map_d'
    a := by
    rw [d_apply]
    refine hA.intCast_injective ?_
    have h := decompose_d a (-1)
    rw [neg_add_cancel] at h
    rw [hA.toInt_spec, h, hA.eq_zero_of_mem_neg (by omega) (decompose (grading (M := A)) a (-1)).2,
