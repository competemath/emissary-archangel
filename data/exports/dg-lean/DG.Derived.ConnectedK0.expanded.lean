-- @@ L306-312 verbatim
/-- The cohomology of `A` in degrees `≤ 2` is that of `ℤ`, except that `H²(A)` is only required
to be torsion-free: `Hⁿ(A) = 0` for `n < 0` and `n = 1`, `H⁰(A) ≅ ℤ`, `H²(A)` torsion-free. -/
structure IntegralLowDegree : Prop where
  neg : ∀ n : ℤ, n < 0 → ∀ x : cohomology A n, x = 0
  zero : Nonempty (cohomology A 0 ≃+ ℤ)
  one : ∀ x : cohomology A 1, x = 0
  two : ∀ m : ℤ, m ≠ 0 → ∀ x : cohomology A 2, m • x = 0 → x = 0


