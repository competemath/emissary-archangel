/-- For `P` K-projective, `Hom_{D(A)}(Q P, (Q N)⟦n⟧) ≃+ Hⁿ(HOM_A(P, N))`: the derived Hom
complex out of `P` is computed by the dg Hom complex. -/
noncomputable def homShiftAddEquivOfIsKProjective {P : DGModuleCat.{v} A}
    (hP : IsKProjective.{v} A P) (N : DGModuleCat.{v} A) (n : ℤ) :
    (Q.obj P ⟶ (Q.obj N)⟦n⟧) ≃+ cohomology (DGModule.HOM A P N) n :=
  let Y := ((HomotopyCategory.quotient A).obj N)⟦n⟧
  let e : Qh.obj Y ≅ (Q.obj N)⟦n⟧ := (Qh.commShiftIso n).app ((HomotopyCategory.quotient A).obj N)
  let c : (Qh.obj ((HomotopyCategory.quotient A).obj P) ⟶ Qh.obj Y) ≃+
      (Qh.obj ((HomotopyCategory.quotient A).obj P) ⟶ (Q.obj N)⟦n⟧) :=
    { toFun := fun f => f ≫ e.hom
      invFun := fun g => g ≫ e.inv
      left_inv := fun f => by simp
      right_inv := fun g => by simp
      map_add' := fun f g => Preadditive.add_comp _ _ _ _ _ _ }
  ((AddEquiv.ofBijective (Qh.mapAddHom (X := (HomotopyCategory.quotient A).obj P) (Y := Y))
      (Qh_map_bijective_of_isKProjective hP Y)).trans c).symm.trans
    (HomotopyCategory.homShiftAddEquivCohomology P N n)


