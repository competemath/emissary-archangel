/-- An isomorphism of dg modules induces isomorphisms on cohomology. -/
noncomputable def DGModuleEquiv.cohomologyAddEquiv (e : DGModuleEquiv A M N) (n : ℤ) :
    cohomology M n ≃+ cohomology N n
    where
  toFun := cohomology.map e.toDGModuleHom n
  invFun := cohomology.map e.symm.toDGModuleHom n
  left_inv
    x := by
    rw [← cohomology.map_comp_apply]
    induction x using cohomology.induction_on with
    | h z =>
      rw [cohomology.map_mk]
      congr 1
      exact Subtype.ext (e.symm_apply_apply _)
  right_inv
    x := by
    rw [← cohomology.map_comp_apply]
    induction x using cohomology.induction_on with
    | h z =>
      rw [cohomology.map_mk]
      congr 1
      exact Subtype.ext (e.apply_symm_apply _)
  map_add' := map_add _


