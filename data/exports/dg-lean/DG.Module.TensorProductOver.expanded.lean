def map (f : M →ₗ[Aᵐᵒᵖ] M') (g : N →ₗ[A] N') :
    TensorProductOver A M N →+ TensorProductOver A M' N' :=
  lift (((tmulAddHom A M' N').compl₂ g.toAddMonoidHom).comp f.toAddMonoidHom)
    fun a m n => by
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddMonoidHom.compl₂_apply,
        LinearMap.toAddMonoidHom_coe, tmulAddHom_apply, map_smul, op_smul_tmul]


