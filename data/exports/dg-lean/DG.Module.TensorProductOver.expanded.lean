-- @@ L258-258 verbatim
variable {P : Type*} [AddCommGroup P]


-- @@ L260-269 verbatim
/-- The additive map `M ⊗_A N →+ P` induced by an `A`-balanced bi-additive map
`f : M →+ N →+ P`, i.e. one with `f (m • a) n = f m (a • n)`. -/
def lift (f : M →+ N →+ P) (hf : ∀ (a : A) (m : M) (n : N), f (op a • m) n = f m (a • n)) :
    TensorProductOver A M N →+ P :=
  QuotientAddGroup.lift _
    (TensorProduct.liftAddHom f fun r m n => by
      rw [map_zsmul, map_zsmul (f m)]; rfl)
    ((AddSubgroup.closure_le _).mpr fun _ ⟨a, m, n, hx⟩ => by
      rw [← hx, SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub, liftAddHom_tmul, liftAddHom_tmul,
        hf, sub_self])


