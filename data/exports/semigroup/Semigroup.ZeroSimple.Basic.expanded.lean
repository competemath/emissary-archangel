variable {S : Type*}


-- @@ L47-47 verbatim
/-! ### Principal two-sided ideals in a semigroup -/


-- @@ L49-49 verbatim
section PrincipalIdeal


-- @@ L51-51 verbatim
variable [Semigroup S]


-- @@ L53-56 expanded
/-- Membership in a principal two-sided ideal is definitionally the `J`-preorder;
the `simp` normal form for passing between the ideal encoding and the `≤𝓙` encoding. -/
@[simp]
theorem mem_principalIdealSet {a b : S} : a ∈ principalIdealSet b ↔ IsGreenJRel a b :=
  Iff.rfl


-- @@ L58-60 verbatim
/-- Every element belongs to its own principal ideal. -/
theorem mem_principalIdealSet_self (a : S) : a ∈ principalIdealSet a :=
  IsGreenJRel.of_eq rfl


-- @@ L62-69 expanded
/-- Being J-below `a` is preserved by left multiplication. -/
theorem IsGreenJRel.mul_left_closed {x a : S} (h : IsGreenJRel x a) (s : S) :
    IsGreenJRel (s * x) a := by
  cases h with
  | of_eq h => exact .mul_left s (by rw [h])
  | mul_left u h => exact .mul_left (s * u) (by rw [h, mul_assoc])
  | mul_right v h => exact .mul_both s v (by rw [h, mul_assoc])
  | mul_both u v h => exact .mul_both (s * u) v (by rw [h]; simp only [mul_assoc])


-- @@ L71-78 expanded
/-- Being J-below `a` is preserved by right multiplication. -/
theorem IsGreenJRel.mul_right_closed {x a : S} (h : IsGreenJRel x a) (s : S) :
    IsGreenJRel (x * s) a := by
  cases h with
  | of_eq h => exact .mul_right s (by rw [h])
  | mul_left u h => exact .mul_both u s (by rw [h])
  | mul_right v h => exact .mul_right (v * s) (by rw [h, mul_assoc])
  | mul_both u v h => exact .mul_both u (v * s) (by rw [h, mul_assoc])


-- @@ L80-84 verbatim
/-- The principal ideal generated by `a` is a semigroup ideal. -/
theorem isSemigroupIdeal_principalIdealSet (a : S) :
    IsSemigroupIdeal (principalIdealSet a) :=
  ⟨⟨a, mem_principalIdealSet_self a⟩,
   fun _ hx s => ⟨hx.mul_left_closed s, hx.mul_right_closed s⟩⟩


-- @@ L86-93 verbatim
/-- A semigroup ideal containing `x` contains the principal ideal of `x`. -/
theorem IsSemigroupIdeal.principalIdealSet_subset {T : Set S} (hT : IsSemigroupIdeal T)
    {x : S} (hx : x ∈ T) : principalIdealSet x ⊆ T := by
  rintro y (rfl | ⟨u, rfl⟩ | ⟨v, rfl⟩ | ⟨u, v, rfl⟩)
  · exact hx
  · exact (hT.2 x hx u).1
  · exact (hT.2 x hx v).2
  · exact (hT.2 _ (hT.2 x hx u).1 v).2


-- @@ L95-99 verbatim
/-- The principal two-sided ideal of `a` is the least semigroup ideal containing `a`. -/
theorem isLeast_principalIdealSet (a : S) :
    IsLeast {T : Set S | IsSemigroupIdeal T ∧ a ∈ T} (principalIdealSet a) :=
  ⟨⟨isSemigroupIdeal_principalIdealSet a, mem_principalIdealSet_self a⟩,
   fun _ hT => hT.1.principalIdealSet_subset hT.2⟩


-- @@ L101-113 expanded
/-- **Bridge to the ideal-theoretic definition of `J`**: `a` and `b` are `J`-related
if and only if they generate the same principal two-sided ideal. -/
theorem isGreenJ_iff_principalIdealSet_eq {a b : S} :
    principalIdealSet a = principalIdealSet b ↔ IsGreenJ a b :=
  by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · have := mem_principalIdealSet_self a; rw [h] at this; exact this
    · have := mem_principalIdealSet_self b; rw [← h] at this; exact this
  · intro h
    exact
      Set.Subset.antisymm ((isSemigroupIdeal_principalIdealSet b).principalIdealSet_subset h.1)
        ((isSemigroupIdeal_principalIdealSet a).principalIdealSet_subset h.2)


-- @@ L115-120 expanded
/-- **Inclusion lemma (two-sided):** if `a ≤𝓙 b` then the principal two-sided ideal
of `a` is contained in that of `b`, i.e. `S¹aS¹ ⊆ S¹bS¹`. Monotonicity of the
principal ideal in `a`, and one inclusion of `isGreenJ_iff_principalIdealSet_eq`. -/
theorem IsGreenJRel.principalIdealSet_subset {a b : S} (h : IsGreenJRel a b) :
    principalIdealSet a ⊆ principalIdealSet b := fun _ hx => IsGreenJRel.trans hx h


-- @@ L122-122 verbatim
end PrincipalIdeal



-- @@ L125-125 verbatim
section ZeroSimple


-- @@ L127-127 verbatim
variable [SemigroupWithZero S]


-- @@ L129-132 verbatim
/-- A 0-simple semigroup contains a nonzero element. -/
theorem IsZeroSimple.exists_ne_zero (hS : IsZeroSimple S) : ∃ a : S, a ≠ 0 := by
  obtain ⟨a, b, hab⟩ := hS.exists_mul_ne_zero
  exact ⟨a, fun h => hab (by rw [h, zero_mul])⟩


-- @@ L134-141 expanded
/-- In a 0-simple semigroup every element is J-below every nonzero element. -/
theorem IsZeroSimple.isGreenJRel_of_ne_zero (hS : IsZeroSimple S) {a : S} (ha : a ≠ 0) (b : S) :
    IsGreenJRel b a :=
  by
  rcases hS.ideal_eq_bot_or_top _ (isSemigroupIdeal_principalIdealSet a) with h | h
  · have hmem := mem_principalIdealSet_self a
    rw [h] at hmem
    exact absurd (Set.mem_singleton_iff.mp hmem) ha
  · exact Set.eq_univ_iff_forall.mp h b


-- @@ L143-146 expanded
/-- In a 0-simple semigroup all nonzero elements are J-equivalent. -/
theorem IsZeroSimple.isGreenJ_of_ne_zero (hS : IsZeroSimple S) {a b : S} (ha : a ≠ 0) (hb : b ≠ 0) :
    IsGreenJ a b :=
  ⟨hS.isGreenJRel_of_ne_zero hb a, hS.isGreenJRel_of_ne_zero ha b⟩


-- @@ L148-161 verbatim
/-- In a 0-simple semigroup `S * S = S`: every element is a product. -/
theorem IsZeroSimple.exists_eq_mul (hS : IsZeroSimple S) (b : S) :
    ∃ x y : S, b = x * y := by
  have hideal : IsSemigroupIdeal {z : S | ∃ x y : S, z = x * y} := by
    obtain ⟨u, v, _⟩ := hS.exists_mul_ne_zero
    refine ⟨⟨u * v, u, v, rfl⟩, ?_⟩
    rintro z ⟨x, y, rfl⟩ s
    exact ⟨⟨s * x, y, (mul_assoc s x y).symm⟩, ⟨x, y * s, mul_assoc x y s⟩⟩
  rcases hS.ideal_eq_bot_or_top _ hideal with h | h
  · obtain ⟨u, v, huv⟩ := hS.exists_mul_ne_zero
    have hmem : u * v ∈ {z : S | ∃ x y : S, z = x * y} := ⟨u, v, rfl⟩
    rw [h] at hmem
    exact absurd (Set.mem_singleton_iff.mp hmem) huv
  · exact Set.eq_univ_iff_forall.mp h b


-- @@ L163-192 verbatim
/-- In a 0-simple semigroup, no nonzero element is annihilated by all
two-sided multiplications: for `a ≠ 0` there are `u, v` with `u * a * v ≠ 0`. -/
theorem IsZeroSimple.exists_mul_mul_ne_zero (hS : IsZeroSimple S)
    {a : S} (ha : a ≠ 0) : ∃ u v : S, u * a * v ≠ 0 := by
  by_contra hcon
  push Not at hcon
  -- the set of elements killed by all two-sided multiplications is an ideal
  have hideal : IsSemigroupIdeal {x : S | ∀ u v : S, u * x * v = 0} := by
    refine ⟨⟨0, fun u v => by simp⟩, ?_⟩
    rintro x hx s
    constructor
    · intro u v
      have h1 := hx (u * s) v
      rwa [mul_assoc u s x] at h1
    · intro u v
      have h2 := hx u (s * v)
      rw [← mul_assoc (u * x) s v] at h2
      rwa [mul_assoc u x s] at h2
  rcases hS.ideal_eq_bot_or_top _ hideal with h | h
  · -- the ideal is {0}, but `a` belongs to it and is nonzero
    have hmem : a ∈ {x : S | ∀ u v : S, u * x * v = 0} := hcon
    rw [h] at hmem
    exact ha (Set.mem_singleton_iff.mp hmem)
  · -- the ideal is everything, contradicting `S * S * S ≠ {0}`
    obtain ⟨p, q, hpq⟩ := hS.exists_mul_ne_zero
    obtain ⟨x, y, rfl⟩ := hS.exists_eq_mul q
    have hx : x ∈ {x : S | ∀ u v : S, u * x * v = 0} := Set.eq_univ_iff_forall.mp h x
    have h0 : p * x * y = 0 := hx p y
    rw [mul_assoc] at h0
    exact hpq h0


-- @@ L194-208 verbatim
/-- **Key structural fact**: in a 0-simple semigroup, `S * a * S = S` for
every nonzero `a` — every element is a two-sided multiple of `a`. -/
theorem IsZeroSimple.exists_eq_mul_mul (hS : IsZeroSimple S)
    {a : S} (ha : a ≠ 0) (b : S) : ∃ u v : S, b = u * a * v := by
  have hideal : IsSemigroupIdeal {z : S | ∃ u v : S, z = u * a * v} := by
    obtain ⟨u, v, _⟩ := hS.exists_mul_mul_ne_zero ha
    refine ⟨⟨u * a * v, u, v, rfl⟩, ?_⟩
    rintro z ⟨u, v, rfl⟩ s
    refine ⟨⟨s * u, v, by simp only [mul_assoc]⟩, ⟨u, v * s, by simp only [mul_assoc]⟩⟩
  rcases hS.ideal_eq_bot_or_top _ hideal with h | h
  · obtain ⟨u, v, huv⟩ := hS.exists_mul_mul_ne_zero ha
    have hmem : u * a * v ∈ {z : S | ∃ u v : S, z = u * a * v} := ⟨u, v, rfl⟩
    rw [h] at hmem
    exact absurd (Set.mem_singleton_iff.mp hmem) huv
  · exact Set.eq_univ_iff_forall.mp h b


-- @@ L210-210 verbatim
end ZeroSimple
