/-!
# One-Sided Ideals: Definitions

This file contains the definitions of the one-sided ideal theory used in the
Rees theorem: left and right ideals, principal one-sided ideals, and 0-minimal
one-sided ideals. The theory built on these definitions lives in
`Semigroup.ZeroSimple.Ideals.Basic`.

## Main definitions

* `IsLeftIdeal`, `IsRightIdeal`: nonempty subsets closed under multiplication on
  the left (resp. right).
* `principalLeftIdealSet`, `principalRightIdealSet`: the principal left ideal
  `{a} ∪ Sa` (resp. right ideal `{a} ∪ aS`) generated by an element.
* `IsZeroMinimalLeftIdeal`, `IsZeroMinimalRightIdeal`: one-sided ideals, different
  from `{0}`, whose only sub-ideals are `{0}` and themselves.

## References

* [J. M. Howie, *Fundamentals of Semigroup Theory*][howie1995]

The proofs formalized in this module closely follow the structure and logic
from lecture notes:

* J. D. Mitchell, *MT5863 Semigroup Theory* (lecture notes,
  University of St Andrews, 2026).
-/


-- @@ L37-37 verbatim
open scoped GreensRelations


-- @@ L39-39 verbatim
variable {S : Type*}


-- @@ L41-41 verbatim
/-! ### One-sided ideals -/


-- @@ L43-43 verbatim
section OneSidedIdeals


-- @@ L45-45 verbatim
variable [Mul S]


-- @@ L47-49 verbatim
/-- A left ideal: a nonempty set closed under multiplication on the left. -/
def IsLeftIdeal (T : Set S) : Prop :=
  T.Nonempty ∧ ∀ a ∈ T, ∀ s : S, s * a ∈ T


-- @@ L51-53 verbatim
/-- A right ideal: a nonempty set closed under multiplication on the right. -/
def IsRightIdeal (T : Set S) : Prop :=
  T.Nonempty ∧ ∀ a ∈ T, ∀ s : S, a * s ∈ T


-- @@ L55-55 verbatim
end OneSidedIdeals


-- @@ L57-57 verbatim
/-! ### Principal one-sided ideals -/


-- @@ L59-59 verbatim
section PrincipalOneSided


-- @@ L61-61 verbatim
variable [Semigroup S]


-- @@ L63-65 expanded
/-- The principal left ideal generated by `a`: `{a} ∪ Sa`, i.e. the set of
elements L-below `a`. -/
def principalLeftIdealSet (a : S) : Set S :=
  {x | IsGreenLeftDvd x a}


-- @@ L67-69 expanded
/-- The principal right ideal generated by `a`: `{a} ∪ aS`, i.e. the set of
elements R-below `a`. -/
def principalRightIdealSet (a : S) : Set S :=
  {x | IsGreenRightDvd x a}


-- @@ L71-71 verbatim
end PrincipalOneSided


-- @@ L73-73 verbatim
/-! ### 0-minimal one-sided ideals -/


-- @@ L75-75 verbatim
section ZeroMinimal


-- @@ L77-77 verbatim
variable [SemigroupWithZero S]


-- @@ L79-84 verbatim
/-- A 0-minimal left ideal: a left ideal, different from `{0}`, whose only
left sub-ideals are `{0}` and itself. -/
structure IsZeroMinimalLeftIdeal (T : Set S) : Prop where
  isLeftIdeal : IsLeftIdeal T
  ne_bot : T ≠ {0}
  eq_bot_or_eq : ∀ T' : Set S, IsLeftIdeal T' → T' ⊆ T → T' = {0} ∨ T' = T


-- @@ L86-91 verbatim
/-- A 0-minimal right ideal: a right ideal, different from `{0}`, whose only
right sub-ideals are `{0}` and itself. -/
structure IsZeroMinimalRightIdeal (T : Set S) : Prop where
  isRightIdeal : IsRightIdeal T
  ne_bot : T ≠ {0}
  eq_bot_or_eq : ∀ T' : Set S, IsRightIdeal T' → T' ⊆ T → T' = {0} ∨ T' = T


-- @@ L93-93 verbatim
end ZeroMinimal
