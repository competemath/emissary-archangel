/-- **Bridge to the ideal-theoretic definition of `L`**: `a` and `b` are `L`-related
if and only if they generate the same principal left ideal. -/
theorem isGreenL_iff_principalLeftIdealSet_eq {a b : S} :
    principalLeftIdealSet a = principalLeftIdealSet b ↔ IsGreenL a b :=
  by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · have := mem_principalLeftIdealSet_self a; rw [h] at this; exact this
    · have := mem_principalLeftIdealSet_self b; rw [← h] at this; exact this
  · intro h
    exact
      Set.Subset.antisymm ((isLeftIdeal_principalLeftIdealSet b).principalLeftIdealSet_subset h.1)
        ((isLeftIdeal_principalLeftIdealSet a).principalLeftIdealSet_subset h.2)


