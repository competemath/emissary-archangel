    ⟨isGreenL_iff_principalLeftIdealSet_eq.mpr h.1, isGreenR_iff_principalRightIdealSet_eq.mpr h.2⟩,
    fun h =>
    ⟨isGreenL_iff_principalLeftIdealSet_eq.mp h.1, isGreenR_iff_principalRightIdealSet_eq.mp h.2⟩⟩


