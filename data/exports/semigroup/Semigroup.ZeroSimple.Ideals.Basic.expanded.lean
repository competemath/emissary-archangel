/-- In a semigroup with zero, every left ideal contains `0`. -/
theorem IsLeftIdeal.zero_mem {T : Set S} (hT : IsLeftIdeal T) : (0 : S) ∈ T := by
  obtain ⟨⟨a, ha⟩, hmul⟩ := hT
  simpa using hmul a ha 0


-- @@ L252-255 verbatim
