/-- Every nonzero element of a 0-simple semigroup with primitive idempotent
`e` is D-related to `e`: writing `x = u * e * v`, the element `e * v` links
`x` to `e` (`x L e * v` via the 0-minimal left ideal `(Se)v`, and
`e * v R e` by primitivity). -/
theorem IsPrimitiveIdempotent.isGreenD_of_ne_zero (hS : IsZeroSimple S) {e : S}
    (he : IsPrimitiveIdempotent e) {x : S} (hx : x ≠ 0) : IsGreenD x e :=
  by
  obtain ⟨u, v, huv⟩ := hS.exists_eq_mul_mul he.ne_zero x
  have hev0 : e * v ≠ 0 := by
    intro h0
    exact
      hx
        (by rw [huv, mul_assoc, h0, mul_zero])
          -- R-half: `e * v R e` by primitivity
          
  have hR : IsGreenR (e * v) e :=
    he.isGreenR_of_idem_mul hS hev0
      (by rw [← mul_assoc, he.isIdempotentElem.eq])
        -- L-half: `x L e * v` via the 0-minimal left ideal `(Se)v`
        
  have hxA : x ∈ (· * v) '' principalLeftIdealSet e := ⟨u * e, Or.inr ⟨u, rfl⟩, huv.symm⟩
  have hAmin : IsZeroMinimalLeftIdeal ((· * v) '' principalLeftIdealSet e) :=
    by
    rcases (he.isZeroMinimalLeftIdeal hS).image_mul_right v with h | h
    · rw [h] at hxA
      exact absurd (Set.mem_singleton_iff.mp hxA) hx
    · exact h
  have hPx : principalLeftIdealSet x = (· * v) '' principalLeftIdealSet e :=
    by
    rcases
      hAmin.eq_bot_or_eq _ (isLeftIdeal_principalLeftIdealSet x)
        (hAmin.isLeftIdeal.principalLeftIdealSet_subset hxA) with
      h | h
    · have hself := mem_principalLeftIdealSet_self x
      rw [h] at hself
      exact absurd (Set.mem_singleton_iff.mp hself) hx
    · exact h
  have hev_mem : e * v ∈ principalLeftIdealSet x :=
    by
    rw [hPx]
    exact ⟨e, mem_principalLeftIdealSet_self e, rfl⟩
  exact ⟨e * v, ⟨Or.inr ⟨u, by rw [huv, mul_assoc]⟩, hev_mem⟩, hR⟩


