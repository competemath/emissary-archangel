/-- In a completely 0-simple semigroup all nonzero elements are D-related:
each is D-related to the primitive idempotent, and D is transitive. -/
theorem IsCompletelyZeroSimple.isGreenD_of_ne_zero (hS : IsCompletelyZeroSimple S) {x y : S}
    (hx : x ≠ 0) (hy : y ≠ 0) : IsGreenD x y :=
  by
  obtain ⟨e, he⟩ := hS.exists_primitive
  exact
    IsGreenD.trans (he.isGreenD_of_ne_zero hS.isZeroSimple hx)
      (IsGreenD.symm (he.isGreenD_of_ne_zero hS.isZeroSimple hy))


