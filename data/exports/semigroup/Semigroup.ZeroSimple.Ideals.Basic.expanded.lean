  obtain ⟨⟨a, ha⟩, hmul⟩ := hT
  simpa using hmul a ha 0


-- @@ L257-262 verbatim
/-- A set containing `0` but different from `{0}` has a nonzero element. -/
theorem exists_mem_ne_zero_of_ne_bot {T : Set S} (h0 : (0 : S) ∈ T)
    (hne : T ≠ {0}) : ∃ a ∈ T, a ≠ 0 := by
  by_contra h
  push Not at h
  exact hne (Set.eq_singleton_iff_unique_mem.mpr ⟨h0, h⟩)


-- @@ L264-305 verbatim
/-- **Translation lemma (right ideals)**: the image `aR` of a 0-minimal right
ideal under left multiplication is either `{0}` or again a 0-minimal right
ideal. -/
theorem IsZeroMinimalRightIdeal.image_mul_left {R : Set S}
    (hR : IsZeroMinimalRightIdeal R) (a : S) :
    (a * ·) '' R = {0} ∨ IsZeroMinimalRightIdeal ((a * ·) '' R) := by
  have hAideal : IsRightIdeal ((a * ·) '' R) := by
    refine ⟨hR.isRightIdeal.1.image _, ?_⟩
    rintro x ⟨r, hr, rfl⟩ s
    exact ⟨r * s, hR.isRightIdeal.2 r hr s, (mul_assoc a r s).symm⟩
  by_cases hbot : (a * ·) '' R = {0}
  · exact Or.inl hbot
  refine Or.inr ⟨hAideal, hbot, ?_⟩
  intro T hT hTA
  -- pull `T` back to a right sub-ideal of `R`
  have hBideal : IsRightIdeal ({r ∈ R | a * r ∈ T} ∪ {0}) := by
    refine ⟨⟨0, Or.inr rfl⟩, ?_⟩
    rintro r (⟨hrR, hrT⟩ | rfl) s
    · refine Or.inl ⟨hR.isRightIdeal.2 r hrR s, ?_⟩
      rw [← mul_assoc]
      exact hT.2 _ hrT s
    · exact Or.inr (Set.mem_singleton_iff.mpr (zero_mul s))
  have hBsub : {r ∈ R | a * r ∈ T} ∪ {0} ⊆ R := by
    rintro r (⟨hrR, _⟩ | rfl)
    · exact hrR
    · exact hR.isRightIdeal.zero_mem
  rcases hR.eq_bot_or_eq _ hBideal hBsub with hB | hB
  · -- the pullback is `{0}`, so `T = {0}`
    left
    refine Set.eq_singleton_iff_unique_mem.mpr ⟨hT.zero_mem, fun t htT => ?_⟩
    obtain ⟨r, hrR, rfl⟩ := hTA htT
    have hrB : r ∈ {r ∈ R | a * r ∈ T} ∪ {0} := Or.inl ⟨hrR, htT⟩
    rw [hB] at hrB
    simp [Set.mem_singleton_iff.mp hrB]
  · -- the pullback is all of `R`, so `T` is the whole image
    right
    refine Set.Subset.antisymm hTA ?_
    rintro x ⟨r, hrR, rfl⟩
    have hrB : r ∈ {r ∈ R | a * r ∈ T} ∪ {0} := by rw [hB]; exact hrR
    rcases hrB with ⟨_, hrT⟩ | rfl
    · exact hrT
    · simpa using hT.zero_mem


-- @@ L307-348 verbatim
/-- **Translation lemma (left ideals)**: the image `La` of a 0-minimal left
