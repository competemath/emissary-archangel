/-! ### Adequacy of the encoding

The divisibility preorders encode membership in the principal ideals of `S¹`,
the monoid `WithOne S` obtained from `S` by adjoining an identity. The next
three lemmas record that the encoding is adequate: `a ≤𝓛 b` holds exactly when
`a ∈ S¹b`, and similarly on the right and on both sides. -/


-- @@ L184-184 verbatim
section Adequacy


-- @@ L186-186 verbatim
variable [Semigroup S]


-- @@ L188-200 verbatim
/-- **Adequacy of the encoding (left)**: `a` lies in the principal left ideal
`S¹b`, where `S¹ = WithOne S`, if and only if `a = b` or `a = c * b` for some
`c ∈ S`. -/
theorem mem_principalLeftIdealSet_iff (a b : S) :
    a ∈ principalLeftIdealSet b ↔ ∃ c : WithOne S, (a : WithOne S) = c * b := by
  constructor
  · rintro (rfl | ⟨c, rfl⟩)
    · exact ⟨1, (one_mul _).symm⟩
    · exact ⟨(c : WithOne S), WithOne.coe_mul c b⟩
  · rintro ⟨c, hc⟩
    cases c with
    | one => rw [one_mul] at hc; exact Or.inl (by exact_mod_cast hc)
    | coe z => exact Or.inr ⟨z, by exact_mod_cast hc⟩


-- @@ L202-214 verbatim
/-- **Adequacy of the encoding (right)**: `a` lies in the principal right ideal
`bS¹`, where `S¹ = WithOne S`, if and only if `a = b` or `a = b * c` for some
`c ∈ S`. -/
theorem mem_principalRightIdealSet_iff (a b : S) :
    a ∈ principalRightIdealSet b ↔ ∃ c : WithOne S, (a : WithOne S) = b * c := by
  constructor
  · rintro (rfl | ⟨c, rfl⟩)
    · exact ⟨1, (mul_one _).symm⟩
    · exact ⟨(c : WithOne S), WithOne.coe_mul b c⟩
  · rintro ⟨c, hc⟩
    cases c with
    | one => rw [mul_one] at hc; exact Or.inl (by exact_mod_cast hc)
    | coe z => exact Or.inr ⟨z, by exact_mod_cast hc⟩


-- @@ L216-237 verbatim
/-- **Adequacy of the encoding (two-sided)**: `a` lies in the principal two-sided
ideal `S¹bS¹`, where `S¹ = WithOne S`, if and only if one of `a = b`, `a = u * b`,
`a = b * v`, `a = u * b * v` holds for some `u v ∈ S`. -/
theorem mem_principalIdealSet_iff (a b : S) :
    a ∈ principalIdealSet b ↔ ∃ u v : WithOne S, (a : WithOne S) = u * b * v := by
  constructor
  · rintro (rfl | ⟨u, rfl⟩ | ⟨v, rfl⟩ | ⟨u, v, rfl⟩)
    · exact ⟨1, 1, by rw [one_mul, mul_one]⟩
    · exact ⟨(u : WithOne S), 1, by rw [mul_one, WithOne.coe_mul]⟩
    · exact ⟨1, (v : WithOne S), by rw [one_mul, WithOne.coe_mul]⟩
    · exact ⟨(u : WithOne S), (v : WithOne S), by rw [WithOne.coe_mul, WithOne.coe_mul]⟩
  · rintro ⟨u, v, huv⟩
    cases u with
    | one =>
      rw [one_mul] at huv
      cases v with
      | one => rw [mul_one] at huv; exact IsGreenJRel.of_eq (by exact_mod_cast huv)
      | coe z => exact IsGreenJRel.mul_right z (by exact_mod_cast huv)
    | coe w =>
      cases v with
      | one => rw [mul_one] at huv; exact IsGreenJRel.mul_left w (by exact_mod_cast huv)
      | coe z => exact IsGreenJRel.mul_both w z (by exact_mod_cast huv)


-- @@ L239-239 verbatim
end Adequacy


