-- @@ L76-78 verbatim
/-- Every element belongs to its own principal right ideal. -/
theorem mem_principalRightIdealSet_self (a : S) : a ∈ principalRightIdealSet a :=
  Or.inl rfl


-- @@ L80-86 verbatim
/-- The principal left ideal generated by `a` is a left ideal. -/
theorem isLeftIdeal_principalLeftIdealSet (a : S) :
    IsLeftIdeal (principalLeftIdealSet a) := by
  refine ⟨⟨a, mem_principalLeftIdealSet_self a⟩, ?_⟩
  rintro x (rfl | ⟨c, rfl⟩) s
  · exact Or.inr ⟨s, rfl⟩
  · exact Or.inr ⟨s * c, (mul_assoc s c a).symm⟩


-- @@ L88-94 verbatim
/-- The principal right ideal generated by `a` is a right ideal. -/
theorem isRightIdeal_principalRightIdealSet (a : S) :
    IsRightIdeal (principalRightIdealSet a) := by
  refine ⟨⟨a, mem_principalRightIdealSet_self a⟩, ?_⟩
  rintro x (rfl | ⟨c, rfl⟩) s
  · exact Or.inr ⟨s, rfl⟩
  · exact Or.inr ⟨c * s, mul_assoc a c s⟩


