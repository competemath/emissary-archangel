theorem isGreenR_iff_principalRightIdealSet_eq {a b : S} :
    principalRightIdealSet a = principalRightIdealSet b ↔ IsGreenR a b :=
  by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · have := mem_principalRightIdealSet_self a; rw [h] at this; exact this
    · have := mem_principalRightIdealSet_self b; rw [← h] at this; exact this
  · intro h
    exact
      Set.Subset.antisymm
        ((isRightIdeal_principalRightIdealSet b).principalRightIdealSet_subset h.1)
        ((isRightIdeal_principalRightIdealSet a).principalRightIdealSet_subset h.2)


