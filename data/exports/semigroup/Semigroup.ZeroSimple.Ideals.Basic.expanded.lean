    rintro x ⟨l, hl, rfl⟩ s
    exact ⟨s * l, hL.isLeftIdeal.2 l hl s, mul_assoc s l a⟩
  by_cases hbot : (· * a) '' L = {0}
  · exact Or.inl hbot
  refine Or.inr ⟨hAideal, hbot, ?_⟩
  intro T hT hTA
  -- pull `T` back to a left sub-ideal of `L`
  have hBideal : IsLeftIdeal ({l ∈ L | l * a ∈ T} ∪ {0}) := by
    refine ⟨⟨0, Or.inr rfl⟩, ?_⟩
    rintro l (⟨hlL, hlT⟩ | rfl) s
