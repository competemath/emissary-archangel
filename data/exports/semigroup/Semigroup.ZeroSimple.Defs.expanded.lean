-- @@ L10-39 verbatim
/-!
# 0-Simple and Completely 0-Simple Semigroups: Definitions

This file contains the basic definitions of the theory of 0-simple semigroups:
two-sided semigroup ideals, 0-simplicity, primitive idempotents, and complete
0-simplicity.

## Main definitions

* `IsSemigroupIdeal`: a nonempty subset closed under multiplication by arbitrary
  elements on both sides.
* `principalIdealSet`: the principal two-sided ideal generated by an element,
  i.e. the set of elements J-below it.
* `IsZeroSimple`: a semigroup with zero is 0-simple if `S * S ≠ {0}` and its only
  ideals are `{0}` and `S`.
* `IsPrimitiveIdempotent`: a nonzero idempotent that is minimal among nonzero
  idempotents in the natural partial order.
* `IsCompletelyZeroSimple`: a 0-simple semigroup containing a primitive idempotent.

## References

* [J. M. Howie, *Fundamentals of Semigroup Theory*][howie1995]


The proofs formalized in this module closely follow the structure and logic
from lecture notes:

* J. D. Mitchell, *MT5863 Semigroup Theory* (lecture notes,
  University of St Andrews, 2026).
-/


-- @@ L41-41 verbatim
open scoped GreensRelations


-- @@ L43-43 verbatim
section Definitions


-- @@ L45-45 verbatim
variable {S : Type*}


-- @@ L47-50 verbatim
/-- A (two-sided) semigroup ideal: a nonempty set closed under multiplication
by arbitrary elements on either side. -/
def IsSemigroupIdeal [Mul S] (T : Set S) : Prop :=
  T.Nonempty ∧ ∀ a ∈ T, ∀ s : S, s * a ∈ T ∧ a * s ∈ T


-- @@ L52-54 expanded
/-- The principal two-sided ideal generated by `a`: the set of elements
J-below `a`, i.e. `{a} ∪ Sa ∪ aS ∪ SaS`. -/
def principalIdealSet [Semigroup S] (a : S) : Set S :=
  {x | IsGreenJRel x a}


-- @@ L56-60 verbatim
/-- A semigroup with zero is 0-simple if `S * S ≠ {0}` and its only ideals
are `{0}` and `S` itself. -/
structure IsZeroSimple (S : Type*) [SemigroupWithZero S] : Prop where
  exists_mul_ne_zero : ∃ a b : S, a * b ≠ 0
  ideal_eq_bot_or_top : ∀ T : Set S, IsSemigroupIdeal T → T = {0} ∨ T = Set.univ


-- @@ L62-67 verbatim
/-- A nonzero idempotent `e` is primitive if the only nonzero idempotent
below it (in the natural partial order on idempotents) is `e` itself. -/
structure IsPrimitiveIdempotent [SemigroupWithZero S] (e : S) : Prop where
  isIdempotentElem : IsIdempotentElem e
  ne_zero : e ≠ 0
  eq_of_le : ∀ f : S, IsIdempotentElem f → f ≠ 0 → e * f = f → f * e = f → f = e


-- @@ L69-73 verbatim
/-- A semigroup with zero is completely 0-simple if it is 0-simple and
contains a primitive idempotent. -/
structure IsCompletelyZeroSimple (S : Type*) [SemigroupWithZero S] : Prop where
  isZeroSimple : IsZeroSimple S
  exists_primitive : ∃ e : S, IsPrimitiveIdempotent e


-- @@ L75-75 verbatim
end Definitions
