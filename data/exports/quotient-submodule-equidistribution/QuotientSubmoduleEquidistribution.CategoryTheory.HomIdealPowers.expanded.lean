-- @@ L136-142 expanded
/-- A single allowed composite belongs to the product ideal. -/
theorem comp_mem_mul {I J : HomIdeal C} {X Y Z : C} {f : X ⟶ Y} {g : Y ⟶ Z} (hf : f ∈ I.hom X Y)
    (hg : g ∈ J.hom Y Z) : f ≫ g ∈ (mul I J).hom X Z :=
  AddSubgroup.subset_closure ⟨Y, f, g, hf, hg, rfl⟩


-- @@ L144-156 expanded
/-- Multiplication is monotone in both variables. -/
theorem mul_mono {I I' J J' : HomIdeal C} (hI : I ≤ I') (hJ : J ≤ J') : mul I J ≤ mul I' J' :=
  by
  intro X Z h hh
  induction hh using AddSubgroup.closure_induction with
  | mem h hh =>
    obtain ⟨Y, f, g, hf, hg, rfl⟩ := hh
    exact comp_mem_mul (hI X Y hf) (hJ Y Z hg)
  | zero => exact zero_mem _
  | add f g _ _ hf hg => exact add_mem hf hg
  | neg f _ hf => exact neg_mem hf


-- @@ L158-169 expanded
/-- Every product lies in its left factor, since the left factor is closed
under postcomposition. -/
theorem mul_le_left (I J : HomIdeal C) : mul I J ≤ I :=
  by
  intro X Z h hh
  induction hh using AddSubgroup.closure_induction with
  | mem h hh =>
    obtain ⟨Y, f, g, hf, hg, rfl⟩ := hh
    exact I.postcomp g hf
  | zero => exact zero_mem _
  | add f g _ _ hf hg => exact add_mem hf hg
  | neg f _ hf => exact neg_mem hf


-- @@ L171-182 expanded
/-- Every product lies in its right factor, since the right factor is closed
under precomposition. -/
theorem mul_le_right (I J : HomIdeal C) : mul I J ≤ J :=
  by
  intro X Z h hh
  induction hh using AddSubgroup.closure_induction with
  | mem h hh =>
    obtain ⟨Y, f, g, hf, hg, rfl⟩ := hh
    exact J.precomp f hg
  | zero => exact zero_mem _
  | add f g _ _ hf hg => exact add_mem hf hg
  | neg f _ hf => exact neg_mem hf


-- @@ L184-192 expanded
@[simp]
theorem top_mul (I : HomIdeal C) : mul ⊤ I = I :=
  by
  apply le_antisymm (mul_le_right _ _) ?_
  intro X Y f hf
  have hcomp : (𝟙 X) ≫ f ∈ (mul (⊤ : HomIdeal C) I).hom X Y := comp_mem_mul (by simp) hf
  simpa using hcomp


-- @@ L194-202 expanded
@[simp]
theorem mul_top (I : HomIdeal C) : mul I ⊤ = I :=
  by
  apply le_antisymm (mul_le_left _ _) ?_
  intro X Y f hf
  have hcomp : f ≫ 𝟙 Y ∈ (mul I (⊤ : HomIdeal C)).hom X Y := comp_mem_mul hf (by simp)
  simpa using hcomp


-- @@ L204-207 expanded
@[simp]
theorem bot_mul (I : HomIdeal C) : mul ⊥ I = ⊥ :=
  le_antisymm (mul_le_left _ _) bot_le


-- @@ L209-212 expanded
@[simp]
theorem mul_bot (I : HomIdeal C) : mul I ⊥ = ⊥ :=
  le_antisymm (mul_le_right _ _) bot_le


-- @@ L214-252 expanded
/-- Associativity follows from associativity and bilinearity of categorical
composition; the closure induction accounts for finite additive sums. -/
theorem mul_assoc (I J K : HomIdeal C) : mul (mul I J) K = mul I (mul J K) :=
  by
  apply le_antisymm
  · intro X Z h hh
    induction hh using AddSubgroup.closure_induction with
    | mem h hh =>
      obtain ⟨Y, f, g, hf, hg, rfl⟩ := hh
      induction hf using AddSubgroup.closure_induction with
      | mem f hf =>
        obtain ⟨M, a, b, ha, hb, rfl⟩ := hf
        rw [Category.assoc]
        exact comp_mem_mul ha (comp_mem_mul hb hg)
      | zero => simp
      | add f₁ f₂ _ _ hf₁ hf₂ => simpa only [Preadditive.add_comp] using add_mem hf₁ hf₂
      | neg f _ hf => simpa only [Preadditive.neg_comp] using neg_mem hf
    | zero => exact zero_mem _
    | add h₁ h₂ _ _ hh₁ hh₂ => exact add_mem hh₁ hh₂
    | neg h _ hh => exact neg_mem hh
  · intro X Z h hh
    induction hh using AddSubgroup.closure_induction with
    | mem h hh =>
      obtain ⟨Y, f, g, hf, hg, rfl⟩ := hh
      induction hg using AddSubgroup.closure_induction with
      | mem g hg =>
        obtain ⟨M, a, b, ha, hb, rfl⟩ := hg
        rw [← Category.assoc]
        exact comp_mem_mul (comp_mem_mul hf ha) hb
      | zero => simp
      | add g₁ g₂ _ _ hg₁ hg₂ => simpa only [Preadditive.comp_add] using add_mem hg₁ hg₂
      | neg g _ hg => simpa only [Preadditive.comp_neg] using neg_mem hg
    | zero => exact zero_mem _
    | add h₁ h₂ _ _ hh₁ hh₂ => exact add_mem hh₁ hh₂
    | neg h _ hh => exact neg_mem hh


-- @@ L254-258 expanded
/-- Right-recursive powers of a categorical Hom ideal.  The zeroth power is
the whole Hom ideal. -/
def pow (I : HomIdeal C) : ℕ → HomIdeal C
  | 0 => ⊤
  | n + 1 => mul (pow I n) I


-- @@ L260-262 verbatim
@[simp]
theorem pow_zero (I : HomIdeal C) : pow I 0 = ⊤ :=
  rfl


-- @@ L264-267 expanded
@[simp]
theorem pow_succ (I : HomIdeal C) (n : ℕ) : pow I (n + 1) = mul (pow I n) I :=
  rfl


-- @@ L269-271 verbatim
@[simp]
theorem pow_one (I : HomIdeal C) : pow I 1 = I := by
  rw [show 1 = 0 + 1 by rfl, pow_succ, pow_zero, top_mul]


-- @@ L273-284 expanded
/-- Powers also have the left-recursive form. -/
theorem pow_succ_eq_mul_pow (I : HomIdeal C) : ∀ n : ℕ, pow I (n + 1) = mul I (pow I n)
  | 0 => by simp
  | n + 1 => by
    calc
      pow I ((n + 1) + 1) = mul (pow I (n + 1)) I := pow_succ I (n + 1)
      _ = mul (mul I (pow I n)) I := by rw [pow_succ_eq_mul_pow I n]
      _ = mul I (mul (pow I n) I) := (mul_assoc I (pow I n) I)
      _ = mul I (pow I (n + 1)) := by rw [← pow_succ]


-- @@ L286-290 verbatim
/-- Pointwise inclusion is preserved by every power. -/
theorem pow_mono {I J : HomIdeal C} (hIJ : I ≤ J) :
    ∀ n, pow I n ≤ pow J n
  | 0 => le_rfl
  | n + 1 => mul_mono (pow_mono hIJ n) hIJ


-- @@ L292-295 verbatim
/-- Ideal powers form a descending chain. -/
theorem pow_succ_le_pow (I : HomIdeal C) (n : ℕ) :
    pow I (n + 1) ≤ pow I n :=
  mul_le_left _ _


-- @@ L297-304 verbatim
/-- Larger exponents give smaller powers. -/
theorem pow_le_pow_of_le (I : HomIdeal C) {m n : ℕ}
    (hmn : m ≤ n) :
    pow I n ≤ pow I m := by
  induction hmn with
  | refl => exact le_rfl
  | @step n hmn ih =>
      exact (pow_succ_le_pow I n).trans ih


-- @@ L306-318 verbatim
/-- The pointwise intersection of all powers. -/
def powerIntersection (I : HomIdeal C) : HomIdeal C where
  hom X Y := ⨅ n, (pow I n).hom X Y
  precomp := by
    intro X Y Z f g hg
    simp only [AddSubgroup.mem_iInf] at hg ⊢
    intro n
    exact (pow I n).precomp f (hg n)
  postcomp := by
    intro X Y Z f g hf
    simp only [AddSubgroup.mem_iInf] at hf ⊢
    intro n
    exact (pow I n).postcomp g (hf n)


-- @@ L320-325 verbatim
@[simp]
theorem mem_powerIntersection_iff
    {I : HomIdeal C} {X Y : C} {f : X ⟶ Y} :
    f ∈ (powerIntersection I).hom X Y ↔
      ∀ n, f ∈ (pow I n).hom X Y := by
  simp [powerIntersection]


-- @@ L327-329 verbatim
/-- A categorical Hom ideal is nilpotent if one of its powers is zero. -/
def IsNilpotent (I : HomIdeal C) : Prop :=
  ∃ N : ℕ, pow I N = ⊥


-- @@ L331-342 verbatim
/-- Nilpotence forces the intersection of all powers to vanish. -/
theorem powerIntersection_eq_bot_of_isNilpotent
    {I : HomIdeal C} (hI : IsNilpotent I) :
    powerIntersection I = ⊥ := by
  obtain ⟨N, hN⟩ := hI
  apply le_antisymm
  · intro X Y f hf
    have hfN : f ∈ (pow I N).hom X Y :=
      (mem_powerIntersection_iff.mp hf) N
    rw [hN] at hfN
    exact hfN
  · exact bot_le


-- @@ L344-353 verbatim
/-- Elementwise form of the same separatedness conclusion. -/
theorem eq_zero_of_mem_every_power
    {I : HomIdeal C} (hI : IsNilpotent I)
    {X Y : C} {f : X ⟶ Y}
    (hf : ∀ n, f ∈ (pow I n).hom X Y) :
    f = 0 := by
  obtain ⟨N, hN⟩ := hI
  have hfN := hf N
  rw [hN] at hfN
  simpa using hfN


