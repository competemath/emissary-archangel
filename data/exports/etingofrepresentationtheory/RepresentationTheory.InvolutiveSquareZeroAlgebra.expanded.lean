      fin_cases i
      · exact hg w hw
      · change squareZeroGenerator • w ∈ W
        rw [hx w]
        exact W.zero_mem
  | mul p q hp hq =>
      intro w hw
      rw [map_mul, mul_smul]
      exact hp _ (hq w hw)
  | add p q hp hq =>
      intro w hw
      rw [map_add, add_smul]
      exact W.add_mem (hp w hw) (hq w hw)



