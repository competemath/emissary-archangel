/-- The relation on free-algebra words used to present the involutive square-zero algebra. -/
inductive Relation : FreeAlgebra ℂ GeneratorIndex → FreeAlgebra ℂ GeneratorIndex → Prop
  | anticomm : Relation (freeAlgebraElementOne * freeAlgebraElementTwo + freeAlgebraElementTwo * freeAlgebraElementOne) 0
  | xsq : Relation (freeAlgebraElementTwo * freeAlgebraElementTwo) 0
  | gsq : Relation (freeAlgebraElementOne * freeAlgebraElementOne) 1



