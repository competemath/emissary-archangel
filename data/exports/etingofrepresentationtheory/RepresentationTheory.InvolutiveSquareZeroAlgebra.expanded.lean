    representationOfGeneratorRelations G X hgx hxx hgg involutionGenerator = G := by
  simp only [representationOfGeneratorRelations, involutionGenerator, freeAlgebraToAlgebra, RingQuot.liftAlgHom_mkAlgHom_apply, FreeAlgebra.lift_ι_apply,
    Matrix.cons_val_zero]


-- @@ L132-137 verbatim
