    representationOfGeneratorRelations G X hgx hxx hgg squareZeroGenerator = X := by
  simp only [representationOfGeneratorRelations, squareZeroGenerator, freeAlgebraToAlgebra, RingQuot.liftAlgHom_mkAlgHom_apply, FreeAlgebra.lift_ι_apply,
    Matrix.cons_val_one, Matrix.cons_val_zero]



-- @@ L140-167 verbatim
/-- A complex-linear map intertwining the involution and square-zero generators intertwines every algebra element. -/
lemma intertwines_of_intertwines_generators {W : Type v} [AddCommGroup W] [Module ℂ W]
    (ρV : Algebra →ₐ[ℂ] Module.End ℂ V) (ρW : Algebra →ₐ[ℂ] Module.End ℂ W) (φ : V →ₗ[ℂ] W)
    (hg : ∀ v, φ (ρV involutionGenerator v) = ρW involutionGenerator (φ v)) (hx : ∀ v, φ (ρV squareZeroGenerator v) = ρW squareZeroGenerator (φ v)) :
    ∀ (a : Algebra) (v : V), φ (ρV a v) = ρW a (φ v) := by
  intro a
  obtain ⟨w, rfl⟩ : ∃ w, freeAlgebraToAlgebra w = a := RingQuot.mkAlgHom_surjective ℂ Relation a
  induction w with
  | grade0 r =>
      intro v
      have hV : ρV (freeAlgebraToAlgebra (algebraMap ℂ (FreeAlgebra ℂ GeneratorIndex) r))
          = algebraMap ℂ (Module.End ℂ V) r := by rw [freeAlgebraToAlgebra.commutes, ρV.commutes]
      have hW : ρW (freeAlgebraToAlgebra (algebraMap ℂ (FreeAlgebra ℂ GeneratorIndex) r))
          = algebraMap ℂ (Module.End ℂ W) r := by rw [freeAlgebraToAlgebra.commutes, ρW.commutes]
      rw [hV, hW, Module.algebraMap_end_apply, Module.algebraMap_end_apply, map_smul]
  | grade1 i =>
      intro v
      fin_cases i
      · exact hg v
      · exact hx v
  | mul a b ha hb =>
      intro v
      simp only [map_mul, Module.End.mul_apply] at *
      rw [ha, hb]
  | add a b ha hb =>
      intro v
      simp only [map_add, LinearMap.add_apply, map_add] at *
      rw [ha, hb]



-- @@ L170-180 verbatim
/-- An algebra-linear map obtained from a complex-linear map that intertwines both distinguished generators. -/
noncomputable def algebraLinearMapOfIntertwinesGenerators {W : Type v} [AddCommGroup W] [Module ℂ W]
    [Module Algebra V] [Module Algebra W]
    (ρV : Algebra →ₐ[ℂ] Module.End ℂ V) (ρW : Algebra →ₐ[ℂ] Module.End ℂ W)
    (hV : ∀ (a : Algebra) (v : V), a • v = ρV a v) (hW : ∀ (a : Algebra) (w : W), a • w = ρW a w)
    (φ : V →ₗ[ℂ] W) (hg : ∀ v, φ (ρV involutionGenerator v) = ρW involutionGenerator (φ v)) (hx : ∀ v, φ (ρV squareZeroGenerator v) = ρW squareZeroGenerator (φ v)) :
    V →ₗ[Algebra] W where
  toFun := φ
  map_add' := φ.map_add
  map_smul' a v := by
    simp only [hV, hW, RingHom.id_apply, intertwines_of_intertwines_generators ρV ρW φ hg hx a v]


