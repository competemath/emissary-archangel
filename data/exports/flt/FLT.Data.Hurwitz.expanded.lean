-- @@ L241-250 expanded
/-- Multiplication `z*w` of two Hurwitz numbers -/
def mul (z w : Hurwitz) : Hurwitz
    where
  re :=
    z.re * w.re - z.imO * w.imO - z.imI * w.imO - z.imI * w.imI + z.imI * w.imOI - z.imOI * w.imOI
  imO :=
    z.imO * w.re + z.re * w.imO - z.imO * w.imO - z.imOI * w.imO - z.imOI * w.imI + z.imI * w.imOI
  imI :=
    z.imI * w.re - z.imI * w.imO + z.imOI * w.imO + z.re * w.imI - z.imO * w.imOI - z.imI * w.imOI
  imOI :=
    z.imOI * w.re - z.imI * w.imO + z.imO * w.imI + z.re * w.imOI - z.imO * w.imOI - z.imOI * w.imOI


