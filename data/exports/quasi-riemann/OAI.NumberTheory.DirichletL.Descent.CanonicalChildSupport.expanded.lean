variable {ι:Type*}[DecidableEq ι](p:ι→O)(hp:∀i,p i≠0)[∀i,(Ideal.span {p i}).IsMaximal]

-- @@ L13-13 verbatim
variable (hg:∀i,ConcretePrimeRowBridge.goodLambda∉Ideal.span {p i})

