  have hξD : i η ∈ 𝐏.basicOpen g := hηx.mem_open (𝐏.basicOpen g).isOpen hxD
  let gens := regularGeneratorsOfList (i.ker.ideal Daff) _ hker hregS
  have hl := length_eq_coheight k n i Daff hξD gens.toQuasiregular
  have hl' : ((ys.map (algebraMap Γ(𝐏, V) Γ(𝐏, 𝐏.basicOpen g))).length : ℕ∞) = coheight (i η) :=
    hl
  rw [← hl']
  simp


-- @@ L764-783 verbatim
/-- **The `QuasiregularCover` of a regular closed integral subscheme of a regular scheme.**

If every stalk of `𝐏 = ℙⁿ_k` and every stalk of the integral scheme `X` is a regular local ring and
`i : X ⟶ 𝐏` is a closed immersion, then `ker i` carries a (regular, hence quasi-regular) cover of
constant length `(coheight (i η)).toNat`, the codimension of `X`. -/
noncomputable def quasiregularCover :
    ConormalSheaf.QuasiregularCover i.ker (coheight (i (genericPoint X))).toNat := by
  choose U hU rs hI hreg hlen using exists_regular_chart k n i hP hX
  refine ConormalSheaf.QuasiregularCover.ofRegular (J := X) U ?_
    (fun z => regularGeneratorsOfList (i.ker.ideal (U z)) (rs z) (hI z) (hreg z))
    (fun z => hlen z)
  intro z'
  obtain ⟨z, rfl⟩ := (inferInstance : Surjective i.toImage).surj z'
  refine ⟨z, ?_⟩
  have hpt : i.ker.subschemeι (i.toImage z) = i z := by
    have h := Scheme.Hom.toImage_imageι i
    calc i.ker.subschemeι (i.toImage z) = (i.toImage ≫ i.imageι) z := rfl
      _ = i z := by rw [h]
  rw [hpt]
  exact hU z


