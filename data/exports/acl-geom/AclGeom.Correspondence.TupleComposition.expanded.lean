/-- Tuples with the joint locus of a presentation form a presentation. -/
private def ofIdealEq (P : TupleCorrespondencePair k Ω α β) (a : α → Ω) (b : β → Ω)
    (h : idealOf k (Sum.elim a b) = idealOf k (Sum.elim P.source P.target)) :
    TupleCorrespondencePair k Ω α β where
  source := a
  target := b
  source_rank := by
    have ha : idealOf k a = idealOf k P.source := by
      rw [idealOf_eq_comap_rename (k := k) (Sum.elim_comp_inl a b), h,
        ← idealOf_eq_comap_rename (k := k) (Sum.elim_comp_inl P.source P.target)]
    exact (locusFunctionFieldEquivOfIdealEq ha).trdeg_eq.trans P.source_rank
  target_mem_source j := by
    have hj := mem_racl_image_of_idealOf_eq k h.symm (J := Set.range Sum.inl) (i := Sum.inr j)
      (by rw [← Set.range_comp, Sum.elim_comp_inl]; exact P.target_mem_source j)
    rw [← Set.range_comp, Sum.elim_comp_inl] at hj
    exact hj
  source_mem_target i := by
    have hi := mem_racl_image_of_idealOf_eq k h.symm (J := Set.range Sum.inr) (i := Sum.inl i)
      (by rw [← Set.range_comp, Sum.elim_comp_inr]; exact P.source_mem_target i)
    rw [← Set.range_comp, Sum.elim_comp_inr] at hi
    exact hi


