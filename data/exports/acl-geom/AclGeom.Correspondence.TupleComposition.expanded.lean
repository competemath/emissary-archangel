/-- Composition of presentations at a literally shared middle tuple. -/
def comp (P : TupleCorrespondencePair k Ω α β) (Q : TupleCorrespondencePair k Ω β γ)
    (h : P.target = Q.source) : TupleCorrespondencePair k Ω α γ where
  source := P.source
  target := Q.target
  source_rank := P.source_rank
  target_mem_source j := racl_le_of_subset_racl (Set.range_subset_iff.2 P.target_mem_source)
    (by rw [h]; exact Q.target_mem_source j)
  source_mem_target i := racl_le_of_subset_racl
    (by rw [h]; exact Set.range_subset_iff.2 Q.source_mem_target) (P.source_mem_target i)


