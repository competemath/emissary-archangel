/-- A generic pair of tuples presenting a finite correspondence: the source tuple has rank one
over `k`, and each coordinate of either tuple is algebraic over the field generated by the
other (blueprint (8.1)). -/
structure TupleCorrespondencePair (k Ω : Type*) [Field k] [Field Ω] [Algebra k Ω]
    (α β : Type*) where
  /-- Source tuple of the presentation. -/
  source : α → Ω
  /-- Target tuple of the presentation. -/
  target : β → Ω
  /-- The source tuple generates a field of transcendence degree one over `k`. -/
  source_rank : Algebra.trdeg k (IntermediateField.adjoin k (Set.range source)) = 1
  /-- Each target coordinate is algebraic over the field generated by the source. -/
  target_mem_source : ∀ j, target j ∈ racl k (Set.range source)
  /-- Each source coordinate is algebraic over the field generated by the target. -/
  source_mem_target : ∀ i, source i ∈ racl k (Set.range target)


