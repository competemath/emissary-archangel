-- @@ L222-222 verbatim
variable {B : Type u} [CommRing B] (g : A →+* B)


-- @@ L224-229 verbatim
/-- `map` sends the identity to the identity. -/
lemma map_id : map (n := n) (RingHom.id R) = 𝟙 ℙ(n; R) := by
  rw [map, ← Proj.map_id]
  congr 1
  ext p : 1
  simp [MvPolynomial.map_id]


-- @@ L231-236 verbatim
/-- `map` is contravariantly functorial. -/
lemma map_comp : map (n := n) (g.comp f) = map g ≫ map f := by
  rw [map, map, map, ← Proj.map_comp]
  congr 1
  ext p : 1
  simp [MvPolynomial.map_map]


