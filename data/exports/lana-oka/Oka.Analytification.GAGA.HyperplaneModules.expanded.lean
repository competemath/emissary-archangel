/-- Stalks killed by the germs of the local equations are killed by the ideal of the
hyperplane. -/
lemma smul_eq_zero_of_mem_pushforwardStalkIdeal
    (hA : ∀ (l : Fin (n + 1 + 1)) (y : projectiveSpaceAn.{u} (n + 1))
      (hy : (πLRS (n + 1)).base y ∈ ProjectiveSpace.U (n + 1) (ULift.{u} ℂ) l)
      (m : ((projectiveSpaceAn.{u} (n + 1)).toLocallyRingedSpace.stalkFunctor y).obj A),
      hyperplaneGerm l y hy • m = 0)
    (y : projectiveSpaceAn.{u} (n + 1)) (r) (hr : r ∈ (hyperplaneLRS.{u} n).pushforwardStalkIdeal y)
    (m : ((projectiveSpaceAn.{u} (n + 1)).toLocallyRingedSpace.stalkFunctor y).obj A) :
    r • m = 0 := by
  obtain ⟨l, hl⟩ := exists_mem_U y
  rw [pushforwardStalkIdeal_eq l y hl] at hr
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hr
  rw [mul_smul, hA l y hl m, smul_zero]


